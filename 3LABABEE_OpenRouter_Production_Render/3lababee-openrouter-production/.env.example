# Copy this file to .env and fill in your real values.
# Never commit .env to git.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Local port (do not set on Render; Render provides it)
PORT=3000

# Optional: public URL of the app, sent to OpenRouter as the referer.
# Defaults to http://localhost:PORT
# APP_URL=https://3lababee-product-post-generator.onrender.com
